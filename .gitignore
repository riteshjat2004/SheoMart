# ==========================================================
# SheoMart Monorepo - Production .gitignore
# Frontend (Next.js) + Backend (Node.js) + Mobile (Android) + AI (Python)
# ==========================================================

# ==========================================================
# Environment Variables
# ==========================================================
**/.env
**/.env.*
!**/.env.example

# ==========================================================
# Node.js / Next.js
# ==========================================================
**/node_modules/

# Next.js
**/.next/
**/out/
**/.turbo/
.vercel/

# Build Outputs
**/dist/
**/build/
**/coverage/
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# ==========================================================
# Android Studio / Kotlin / Gradle
# ==========================================================

# Local SDK configuration (machine specific)
**/local.properties

# Android Studio / IntelliJ
.idea/
*.iml

# Gradle cache
**/.gradle/

# Android build outputs
**/build/

# Native build cache
**/.cxx/
**/.externalNativeBuild/

# Kotlin cache
**/.kotlin/

# Android captures
**/captures/

# Generated APK / AAB files
*.apk
*.aab

# Keep website downloadable APK
!sheomart-frontend/public/app/SheoMart-latest.apk

# ==========================================================
# React Native / Expo (Future-proof)
# ==========================================================
**/.expo/
**/.expo-shared/
**/.metro-health-check*
**/web-build/
**/android/app/build/
**/ios/build/

# ==========================================================
# Python (Future AI Services)
# ==========================================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# ==========================================================
# Logs
# ==========================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log

# ==========================================================
# Cache Files
# ==========================================================
.cache/
.parcel-cache/
.eslintcache

# ==========================================================
# Temporary Files
# ==========================================================
*.tmp
*.temp
*.swp
*.swo
*.orig
tmp/
temp/

# ==========================================================
# Runtime Uploads
# ==========================================================
**/uploads/

# ==========================================================
# Local Databases / Dumps
# ==========================================================
*.sqlite
*.db
*.dump
mongodb-dump/

# ==========================================================
# Certificates / Secrets
# ==========================================================
*.pem
*.key
*.crt

# ==========================================================
# Archives
# ==========================================================
*.zip
*.tar
*.gz

# ==========================================================
# VS Code
# ==========================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ==========================================================
# OS Generated Files
# ==========================================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================================
# Project Specific
# ==========================================================

# Ignore local assets folder used for raw design resources
assets/

# Ignore personal notes
info.txt

# Keep deployed public assets
!sheomart-frontend/public/logo/
!sheomart-frontend/public/app/